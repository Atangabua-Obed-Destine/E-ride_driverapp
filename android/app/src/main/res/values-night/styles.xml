<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the process starts, on Android 11 and below. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <!--
        Applied once the process has started and sits behind the Flutter UI for
        the rest of the session. Set to the splash ink rather than the platform
        default, which is white and produced a white flash between the launch
        screen and Flutter's first frame.
    -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_ink</item>
    </style>
</resources>
